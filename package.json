{
	"name": "scatter-gather-viewer-workshop",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "biome format --write .",
		"check-types": "turbo run check-types",
		"setup": "./scripts/setup-env.sh",
		"db:up": "docker compose up -d --wait",
		"db:down": "docker compose down",
		"db:reset": "docker compose down --volumes --remove-orphans && docker compose up -d --wait"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"turbo": "^2.10.13",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.14"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
