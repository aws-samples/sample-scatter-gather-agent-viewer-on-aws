# Local development configuration for apps/web.
# `bun run setup` (scripts/setup-env.sh) fills these in from the deployed CDK
# stack; this file documents the keys. Copy to .env if you prefer to set them
# by hand. Never commit .env.

# Cognito user pool created by the stack (consumed by @repo/auth for
# server-side session lookups).
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=<domain-prefix>.auth.<region>.amazoncognito.com
COGNITO_REGION=us-east-1
COGNITO_USERPOOL_ID=

# Better Auth. The secret must match apps/api/.env.
BETTER_AUTH_SECRET=<random 32+ character string>
BETTER_AUTH_URL=http://localhost:4000

# Where the browser and the SSR server reach the API in development.
VITE_API_URL=http://localhost:4000

# Local Postgres from docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
