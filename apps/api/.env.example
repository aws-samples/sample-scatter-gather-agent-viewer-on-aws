# Local development configuration for apps/api.
# `bun run setup` (scripts/setup-env.sh) fills these in from the deployed CDK
# stack; this file documents the keys. Copy to .env if you prefer to set them
# by hand. Never commit .env.

# Cognito user pool created by the stack (consumed by @repo/auth).
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=<domain-prefix>.auth.<region>.amazoncognito.com
COGNITO_REGION=us-east-1
COGNITO_USERPOOL_ID=

# Better Auth. The secret must match apps/web/.env so both processes can read
# the same session cookies.
BETTER_AUTH_SECRET=<random 32+ character string>
BETTER_AUTH_URL=http://localhost:4000

# Local Postgres from docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Amazon S3 Files resources provisioned per journey (from the stack).
S3_FILES_ROLE_ARN=arn:aws:iam::<account-id>:role/<S3FilesSyncRole>
S3_FILES_MOUNT_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
S3_FILES_MOUNT_SUBNET_IDS=subnet-xxxxxxxxxxxxxxxxx,subnet-yyyyyyyyyyyyyyyyy
AGENT_VPC_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx

# Assessment orchestration (stack outputs AggregatorBucketName / AggregatorRuntimeArn).
AGGREGATOR_BUCKET_NAME=
AGGREGATOR_RUNTIME_ARN=arn:aws:bedrock-agentcore:<region>:<account-id>:runtime/<id>

USER_AGENT_STRING=AWSSOLUTION/SO0352/v0.1.0

# Local Durable Streams server from docker-compose.yml.
DURABLE_STREAMS_URL=http://localhost:4437/v1/stream
DURABLE_STREAMS_WRITER_TOKEN=local-dev-writer-token
